{
  "name": "doumassi-application",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "eas:login": "eas login",
    "eas:init": "eas init",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:staging:android": "eas build --profile staging --platform android",
    "build:prod:android": "eas build --profile production --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@hookform/resolvers": "5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "8.9.1",
    "@shopify/flash-list": "2.3.1",
    "@supabase/supabase-js": "2.104.1",
    "@tamagui/animations-moti": "1.135.5",
    "@tamagui/babel-plugin": "1.135.5",
    "@tamagui/config": "1.135.5",
    "@tanstack/react-query": "5.100.5",
    "expo": "~55.0.17",
    "expo-application": "~55.0.14",
    "expo-audio": "~55.0.14",
    "expo-camera": "~55.0.16",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.28",
    "expo-device": "~55.0.15",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-image": "~55.0.9",
    "expo-image-picker": "~55.0.19",
    "expo-linking": "~55.0.14",
    "expo-localization": "~55.0.13",
    "expo-notifications": "~55.0.20",
    "expo-router": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-updates": "~55.0.21",
    "expo-video": "~55.0.15",
    "lucide-react-native": "1.11.0",
    "posthog-react-native": "4.43.5",
    "posthog-react-native-session-replay": "1.5.5",
    "react": "19.2.0",
    "react-hook-form": "7.74.0",
    "react-native": "0.83.6",
    "react-native-device-info": "15.0.2",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-localize": "3.7.0",
    "react-native-reanimated": "4.3.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "tamagui": "1.135.5",
    "zod": "4.3.6",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.14",
    "eas-cli": "18.8.1",
    "eslint": "9.39.4",
    "eslint-config-expo": "55.0.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
