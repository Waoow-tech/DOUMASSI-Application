# Variables d'environnement DOUMASSI Mobile
# Copier ce fichier en .env.local et remplir avec les vraies valeurs.
# .env.local est gitignored — ne JAMAIS commit de clés réelles ici.

# === Supabase (obligatoire) ===
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# === Sentry (optionnel — laisser vide en dev) ===
# Crée un projet React Native sur https://sentry.io et copie le DSN ici.
EXPO_PUBLIC_SENTRY_DSN=

# === PostHog (optionnel — laisser vide en dev) ===
# Crée un projet sur https://eu.posthog.com et copie le project API key.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
