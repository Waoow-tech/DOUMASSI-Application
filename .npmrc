# Configuration pnpm pour React Native / Expo
# Voir https://pnpm.io/npmrc

# React Native ne supporte pas le strict node_modules de pnpm.
# Tous les modules doivent être hoistés dans le node_modules racine.
node-linker=hoisted

# Force le hoist agressif pour résoudre les alias npm contenant `--`
# (ex: @babel/traverse--for-generate-function-map utilisé par Metro).
# Sans ça, Metro échoue à charger sa config en SDK 55 + pnpm.
shamefully-hoist=true

# Verrouille la version de pnpm utilisée
package-manager-strict=false
